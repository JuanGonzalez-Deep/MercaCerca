<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_splash" android:gravity="bottom"
    android:orientation="vertical" android:padding="20dp" android:paddingTop="48dp">
    <TextView
        android:layout_width="56dp" android:layout_height="56dp"
        android:background="@drawable/bg_circle_accent" android:gravity="center"
        android:text="A" android:textColor="@color/primary_dark"
        android:textSize="24sp" android:textStyle="bold" />
    <TextView
        style="@style/TextAppearance.MC.Title"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="@string/rol_admin"
        android:textColor="@color/white" />
    <TextView
        style="@style/TextAppearance.MC.OnDark"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/panel_admin" />
</LinearLayout>