<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp">
    <TextView style="@style/TextAppearance.MC.Headline" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="4dp" android:text="@string/catalogo" />
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="4dp" android:hint="@string/buscar_producto"
        app:startIconDrawable="@drawable/ic_search">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroup" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingStart="4dp" android:paddingEnd="4dp"
            app:selectionRequired="true" app:singleLine="true" app:singleSelection="true">
            <com.google.android.material.chip.Chip android:id="@+id/chipAll"
                style="@style/Widget.MC.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:checked="true" android:text="@string/todos" />
            
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCafe" style="@style/Widget.MC.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/cat_cafe" />
            
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipLacteos" style="@style/Widget.MC.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/cat_lacteos" />
            
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFrutas" style="@style/Widget.MC.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/cat_frutas" />
            
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDulces" style="@style/Widget.MC.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/cat_dulces" />
            
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDespensa" style="@style/Widget.MC.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/cat_despensa" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="4dp" />
</LinearLayout>