<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView style="@style/TextAppearance.MC.Headline" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/reporte_ventas" />
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.MC.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView style="@style/TextAppearance.MC.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/total_vendido" />
                <TextView style="@style/TextAppearance.MC.Headline" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="$ 23.480.000" android:textColor="@color/primary" />
                <TextView style="@style/TextAppearance.MC.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="@string/ventas_6_meses" />
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="170dp"
                    android:layout_marginTop="8dp" android:orientation="horizontal">
                    
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:gravity="center_horizontal|bottom"
                        android:orientation="vertical">
                        <View android:layout_width="28dp" android:layout_height="60dp"
                            android:background="@drawable/bg_bar_chart" />
                        <TextView style="@style/TextAppearance.MC.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:text="Jun" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:gravity="center_horizontal|bottom"
                        android:orientation="vertical">
                        <View android:layout_width="28dp" android:layout_height="85dp"
                            android:background="@drawable/bg_bar_chart" />
                        <TextView style="@style/TextAppearance.MC.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:text="Jul" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:gravity="center_horizontal|bottom"
                        android:orientation="vertical">
                        <View android:layout_width="28dp" android:layout_height="70dp"
                            android:background="@drawable/bg_bar_chart" />
                        <TextView style="@style/TextAppearance.MC.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:text="Ago" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:gravity="center_horizontal|bottom"
                        android:orientation="vertical">
                        <View android:layout_width="28dp" android:layout_height="110dp"
                            android:background="@drawable/bg_bar_chart" />
                        <TextView style="@style/TextAppearance.MC.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:text="Sep" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:gravity="center_horizontal|bottom"
                        android:orientation="vertical">
                        <View android:layout_width="28dp" android:layout_height="95dp"
                            android:background="@drawable/bg_bar_chart" />
                        <TextView style="@style/TextAppearance.MC.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:text="Oct" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:gravity="center_horizontal|bottom"
                        android:orientation="vertical">
                        <View android:layout_width="28dp" android:layout_height="130dp"
                            android:background="@drawable/bg_bar_chart" />
                        <TextView style="@style/TextAppearance.MC.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:text="Nov" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.MC.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView style="@style/TextAppearance.MC.Title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/top_productos" />
                
                <TextView style="@style/TextAppearance.MC.Title"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="Café de Huila 500 g" android:textSize="15sp" />
                <TextView style="@style/TextAppearance.MC.Caption"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="212 unidades · $5,9 M" />
                <TextView style="@style/TextAppearance.MC.Title"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="Queso campesino" android:textSize="15sp" />
                <TextView style="@style/TextAppearance.MC.Caption"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="174 unidades · $2,8 M" />
                <TextView style="@style/TextAppearance.MC.Title"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="Miel de abeja" android:textSize="15sp" />
                <TextView style="@style/TextAppearance.MC.Caption"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="131 unidades · $2,9 M" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExport" style="@style/Widget.MC.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/exportar_reporte" />
    </LinearLayout>
</ScrollView>