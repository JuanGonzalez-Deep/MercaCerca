<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingBottom="16dp">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_header" android:orientation="vertical"
            android:padding="20dp" android:paddingBottom="32dp">
            <TextView style="@style/TextAppearance.MC.Display"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/saludo" android:textSize="22sp" />
            <TextView style="@style/TextAppearance.MC.OnDark"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/cerca_de_ti" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_margin="16dp" android:background="@drawable/bg_banner"
            android:orientation="vertical" android:padding="20dp">
            <TextView style="@style/TextAppearance.MC.Headline"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/promo_titulo" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/promo_desc" android:textColor="@color/text_primary" />
        </LinearLayout>
        <TextView style="@style/TextAppearance.MC.Title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:text="@string/categorias" />
        <HorizontalScrollView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                app:singleLine="true">
                <com.google.android.material.chip.Chip style="@style/Widget.MC.Chip"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/cat_cafe" />
                <com.google.android.material.chip.Chip style="@style/Widget.MC.Chip"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/cat_lacteos" />
                <com.google.android.material.chip.Chip style="@style/Widget.MC.Chip"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/cat_frutas" />
                <com.google.android.material.chip.Chip style="@style/Widget.MC.Chip"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/cat_dulces" />
                <com.google.android.material.chip.Chip style="@style/Widget.MC.Chip"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/cat_despensa" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
        <TextView style="@style/TextAppearance.MC.Title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginTop="12dp"
            android:text="@string/destacados" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFeatured"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:clipToPadding="false" android:paddingStart="10dp" android:paddingEnd="10dp" />
    </LinearLayout>
</ScrollView>